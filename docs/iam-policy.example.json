{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSoloProgramaciones",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::NOMBRE_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["programaciones-hexagonal/*"]}}
    },
    {
      "Sid": "LeerYGuardarDocumentos",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::NOMBRE_BUCKET/programaciones-hexagonal/*"
    },
    {
      "Sid": "LimpiarOriginalIncompleto",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::NOMBRE_BUCKET/programaciones-hexagonal/originales/*"
    }
  ]
}

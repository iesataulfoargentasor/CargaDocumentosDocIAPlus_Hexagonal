# Genera una clave: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA
S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
S3_PREFIX=programaciones-hexagonal
# Opción 1: perfil local configurado con AWS CLI (incluido session token).
# AWS_PROFILE=academy
# Opción 2: credenciales temporales en este .env, nunca en Git.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
CENTRO=IES Ataúlfo Argenta
MAX_FILE_MB=20
HOST=127.0.0.1
PORT=5053
# true solo cuando sirvas mediante HTTPS.
COOKIE_SECURE=false

# memory solo para demostración: se pierde el corpus al cerrar.
STORAGE_BACKEND=s3
